#!/bin/sh
set -eu

source_path=$0
while [ -L "$source_path" ]; do
  link_target=$(/usr/bin/readlink "$source_path")
  case "$link_target" in
    /*) source_path=$link_target ;;
    *) source_path=$(dirname "$source_path")/$link_target ;;
  esac
done

bin_dir=$(CDPATH= cd -P -- "$(dirname -- "$source_path")" && pwd)
resources_dir=$(CDPATH= cd -- "$bin_dir/.." && pwd)
macos_dir=$(CDPATH= cd -P -- "$resources_dir/../MacOS" && pwd)
LANE_BE_CLI=1 exec "$macos_dir/Lane" "$@"
