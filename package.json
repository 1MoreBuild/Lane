{
  "name": "lane-local-ai-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "A local, multi-provider AI gateway for desktop apps.",
  "author": "Lane contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/1MoreBuild/Lane.git"
  },
  "homepage": "https://github.com/1MoreBuild/Lane#readme",
  "bugs": {
    "url": "https://github.com/1MoreBuild/Lane/issues"
  },
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on http-get://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:icon": "node scripts/build-icon.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:packaging": "node scripts/validate-packaging.mjs",
    "package:mac": "npm run build:icon && npm run build && electron-builder --mac dir --arm64",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "smoke:mac": "node scripts/smoke.mjs",
    "smoke:cli:mac": "node scripts/smoke-cli.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run validate:packaging"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "eslint": "10.0.2",
    "shadcn": "^4.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "works.earendil.lane",
    "productName": "Lane",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/lane-cli",
        "to": "bin/lane"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "target": [
        "dir",
        "dmg"
      ],
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  }
}
